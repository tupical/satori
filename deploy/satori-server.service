# systemd --user unit for satori-server (mcpbox meisei sensemaking tool).
# Independent deploy unit: updating satori rebuilds/redeploys ONLY this service,
# never the mcpbox platform or daruma.
#
# Install: copy the built binary to ~/.local/bin/satori-server, drop this file at
# ~/.config/systemd/user/satori-server.service, put SATORI_PLATFORM_SECRET (the
# platform-shared key) in ~/.config/satori/satori.env, then:
#   systemctl --user daemon-reload && systemctl --user enable --now satori-server
# Front it with nginx `satori.mcpbox.ru -> 127.0.0.1:$SATORI_PORT` and upsert the
# tool_registry row on the platform.

[Unit]
Description=satori-server (mcpbox meisei sensemaking tool)
After=network-online.target

[Service]
Environment=SATORI_PORT=8091
Environment=SATORI_VERSION=0.1.0
# SATORI_PLATFORM_SECRET (and any future keys) live here, NOT in this unit:
EnvironmentFile=-%h/.config/satori/satori.env
ExecStart=%h/.local/bin/satori-server
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
